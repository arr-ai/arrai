(
    singleNest: ({|x,y| (1, 2), (1, 3), (2, 4)} nest y) = {(x: 1, y: {2, 3}), (x: 2, y: {4})},

    nestInverse: ({|x, y, z| (1, 1, 2), (1, 1, 3), (1, 2, 4), (1, 3, 5)} nest ~|z|a) = {
        (a: {(x: 1, y: 1)}, z: 2),
        (a: {(x: 1, y: 1)}, z: 3),
        (a: {(x: 1, y: 2)}, z: 4),
        (a: {(x: 1, y: 3)}, z: 5),
    },

    unnest: ({
        (a: {(x: 1, y: 1)}, z: 2),
        (a: {(x: 1, y: 1)}, z: 3),
        (a: {(x: 1, y: 2)}, z: 4),
        (a: {(x: 1, y: 3)}, z: 5),
    } unnest a) = {|x, y, z| (1, 1, 2), (1, 1, 3), (1, 2, 4), (1, 3, 5)},

    projectKeep:    (a: 1, b: 2, c: 3).|a, b| = (a: 1, b: 2),
    projectDrop:    (a: 1, b: 2, c: 3).~|a| = (b: 2, c: 3),
    projectViaDot:  ((a: 1, b: 2, c: 3) -> .|a|) = (a: 1),
    dotAccess:      (a: (b: 1)).a.b = 1,
)
