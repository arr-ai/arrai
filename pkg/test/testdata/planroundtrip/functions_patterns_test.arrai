(
    arrayPattern:  ([1, 2] -> \[x, y] x + y) = 3,
    tuplePattern:  ((m: 1, n: 2) -> \(m: x, n: y) x + y) = 3,
    dictPattern:   ({"m": 1, "n": 2} -> \{"m": x, "n": y} x + y) = 3,
    extraPattern:  ([1, 2, 3, 4] -> \[x, y, ...t] [x + y, t]) = [3, [3, 4]],
    nestedPattern: ([1, [2, 3]] -> \[x, [y, z]] x + y + z) = 6,
    setPattern:    (cond {(y: 1, z: 2)} { {(:y, :z)}: {(y*z)} }) = {(2)},
)
