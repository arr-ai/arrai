(
    strLower:  //str.lower("ABC") = "abc",
    strUpper:  //str.upper("abc") = "ABC",
    strTitle:  //str.title("hello") = "Hello",
    seqSplit:  //seq.split(',', "a,b,c") = ['a', 'b', 'c'],
    seqJoin:   //seq.join(", ", ["a", "b"]) = "a, b",
    mathSin:   //math.sin(0) = 0,

    # Encoding packages (//encoding.json, //encoding.csv) are entirely
    # untested elsewhere in this corpus - a different NativeFunction call
    # shape (byte-string in/out) from the plain scalar stdlib calls above.
    # The default (strict) JSON decoder disambiguates JSON strings/arrays from
    # arr.ai's own by wrapping them as `(s: ...)`/`(a: ...)` tuples; the
    # non-strict decoder used here gives the more direct string/array shape.
    jsonDecode: //encoding.json.decoder((strict: false))('{"a": 1, "b": "x"}') = {'a': 1, 'b': 'x'},
    jsonEncode: //encoding.json.encode({'a': 1}) = <<'{"a":1}\n'>>,
    csvDecode:  //encoding.csv.decode(<<'a,b,c\n1,2,3\n'>>) = [['a', 'b', 'c'], ['1', '2', '3']],

    # //rel.union takes a *set of sets* and flattens them via n-ary union -
    # distinct from the binary `|` operator tested elsewhere in this corpus.
    relUnion: //rel.union({{1, 2}, {2, 3}, {4}}) = {1, 2, 3, 4},

    fmtPretty: //fmt.pretty([1, 2, 3]) = "[1, 2, 3]",
)
