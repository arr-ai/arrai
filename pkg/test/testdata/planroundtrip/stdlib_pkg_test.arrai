(
    strLower:  //str.lower("ABC") = "abc",
    strUpper:  //str.upper("abc") = "ABC",
    strTitle:  //str.title("hello") = "Hello",
    seqSplit:  //seq.split(',', "a,b,c") = ['a', 'b', 'c'],
    seqJoin:   //seq.join(", ", ["a", "b"]) = "a, b",
    mathSin:   //math.sin(0) = 0,

    # Encoding packages (//encoding.json, //encoding.csv) are entirely
    # untested elsewhere in this corpus - a different NativeFunction call
    # shape (byte-string in/out) from the plain scalar stdlib calls above.
    # The default (strict) JSON decoder disambiguates JSON strings/arrays from
    # arr.ai's own by wrapping them as `(s: ...)`/`(a: ...)` tuples; the
    # non-strict decoder used here gives the more direct string/array shape.
    jsonDecode: //encoding.json.decoder((strict: false))('{"a": 1, "b": "x"}') = {'a': 1, 'b': 'x'},
    jsonEncode: //encoding.json.encode({'a': 1}) = <<'{"a":1}\n'>>,
    csvDecode:  //encoding.csv.decode(<<'a,b,c\n1,2,3\n'>>) = [['a', 'b', 'c'], ['1', '2', '3']],

    # //rel.union takes a *set of sets* and flattens them via n-ary union -
    # distinct from the binary `|` operator tested elsewhere in this corpus.
    relUnion: //rel.union({{1, 2}, {2, 3}, {4}}) = {1, 2, 3, 4},

    fmtPretty: //fmt.pretty([1, 2, 3]) = "[1, 2, 3]",

    bitsSet:  //bits.set(6) = {1, 2},
    bitsMask: //bits.mask({1, 2}) = 6,

    # //seq.concat is a distinct stdlib function from the `+` array-concat
    # binop tested elsewhere - it concatenates an *array of sequences*
    # (strings here) into one.
    seqConcatStrings: //seq.concat(["a", "b", "c"]) = "abc",

    # //seq.join on Bytes interleaves the joiner between each byte - a
    # distinct bytesJoin path from the string-array join tested above.
    seqJoinBytes: //seq.join(<<0>>, <<1, 2, 3>>) = <<1, 0, 2, 0, 3>>,

    # //re.compile returns a tuple of closures (match/sub/subf) over a cached
    # *regexp.Regexp - a completely different shape (a native closure factory,
    # not a plain NativeFunctionAttr) from every other stdlib call in this
    # corpus, and its own offset-string submatch representation.
    reMatch: //re.compile(`.(\d)`).match('a1b2c3') = [['a1', 1\'1'], [2\'b2', 3\'2'], [4\'c3', 5\'3']],
    reSub:   //re.compile(`.(\d)`).sub(`-$1`, 'a1b2c3') = '-1-2-3',
    reSubf:  //re.compile(`.(\d)`).subf(//str.upper, 'a1b2c3') = 'A1B2C3',

    # //encoding.yaml mirrors //encoding.json's shape (strict/non-strict
    # decoder, byte-string encode/decode) but is a completely separate
    # codepath/library - untested elsewhere in this corpus.
    yamlDecode: //encoding.yaml.decoder((strict: false))('a: 1\nb: x\n') = {'a': 1, 'b': 'x'},
    yamlEncode: //encoding.yaml.encode({'a': 1}) = <<'a: 1\n'>>,

    # //archive.tar/zip have no unit test coverage anywhere in the repo (only
    # exercised indirectly via bundling), so this is new coverage for the
    # whole codebase, not just this corpus. There's no decode/untar function
    # to round-trip against, and tar/zip headers here carry no timestamps, so
    # output is deterministic - asserted via self-comparison rather than a
    # hardcoded byte literal (which would be one more thing to keep in sync
    # with the archive libraries' exact header layout).
    archiveTarDeterministic: //archive.tar.tar({'a.txt': 'hi', 'b.txt': 'bye'}) = //archive.tar.tar({'a.txt': 'hi', 'b.txt': 'bye'}),
    archiveZipDeterministic: //archive.zip.zip({'a.txt': 'hi', 'b.txt': 'bye'}) = //archive.zip.zip({'a.txt': 'hi', 'b.txt': 'bye'}),

    # //os.isatty is the one //os function that's safe to assert on here: fds
    # 0/1 are never a real tty under `go test`, so this is deterministic in
    # any CI/local environment. The rest of //os (exists/tree/file/cwd/
    # get_env) depends on the filesystem/environment the test happens to run
    # in, so deliberately left untested here rather than risk flakiness.
    osIsattyStdin:  //os.isatty(0) = false,
    osIsattyStdout: //os.isatty(1) = false,
)
